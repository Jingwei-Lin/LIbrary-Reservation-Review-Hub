    <!-- 2) 批量将该用户对这些书的 waiting 记录改为 notified -->
    <update id="batchNotifyByBooks">
        UPDATE waiting_list
        SET status = 'notified',
        is_notified = 1,
        notification_date = NOW()
        WHERE user_id = #{userId}
        AND book_id IN
        <foreach collection="bookIds" item="bookId" open="(" separator="," close=")">
            #{bookId}
        </foreach>
        AND status = 'WAITING'
    </update>

    <!-- 将 join_date 超过 7 天且仍为 notified 的条目设为 cancelled -->
    <update id="cancelStaleWaiting">
        <![CDATA[
        UPDATE Waiting_list
        SET status = 'cancelled'
        WHERE status = 'notified'
          AND join_date < (CURRENT_TIMESTAMP - INTERVAL 7 DAY)
        ]]>
    </update>
</mapper>
