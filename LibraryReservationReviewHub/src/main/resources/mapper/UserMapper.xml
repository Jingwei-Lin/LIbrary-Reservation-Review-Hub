<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.comp5619.libraryreservationreviewhub.mapper.UserMapper">

    <!-- 字段映射 -->
    <resultMap id="BaseResultMap" type="com.comp5619.libraryreservationreviewhub.model.entity.User">
        <id property="id" column="user_id" jdbcType="BIGINT"/>
        <result property="userAccount" column="email" jdbcType="VARCHAR"/>
        <result property="userPassword" column="password" jdbcType="VARCHAR"/>
        <result property="firstName" column="first_name" jdbcType="VARCHAR"/>
        <result property="lastName" column="last_name" jdbcType="VARCHAR"/>
        <result property="isAdmin" column="is_admin" jdbcType="BOOLEAN"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>



    <!-- 公共字段列表 -->
    <sql id="Base_Column_List">
        user_id, email, password,
        first_name, last_name, is_admin, phone,
        status,create_time, update_time
    </sql>





</mapper>